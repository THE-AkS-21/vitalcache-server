# VitalCache Server — Environment Variable Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=dev                         # dev | staging | prod
PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Supabase-hosted, direct connection)
# Use the Supabase "Session pooler" URL for best pgx compatibility:
#   Project Settings → Database → Connection string → URI
#
# Direct:          postgresql://postgres:[pw]@db.[ref].supabase.co:5432/postgres
# Session pooler:  postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# IMPORTANT: Do NOT use the transaction pooler (port 6543) — incompatible with pgx
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_CONN_LIFETIME_MINS=30
POSTGRES_CONN_IDLE_MINS=5

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB (Atlas)
# ─────────────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://vitalcache_admin:[password]@vitalcache.bbumgvl.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=vitalcache

# ─────────────────────────────────────────────────────────────────────────────
# Redis (Upstash — full URL includes TLS via rediss://)
# Preferred: REDIS_URL (supports both plain and TLS)
# Fallback:  REDIS_ADDR + REDIS_PASSWORD
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379
# REDIS_ADDR=localhost:6379      # used only when REDIS_URL is unset
# REDIS_PASSWORD=                # used only when REDIS_URL is unset
REDIS_DB=0                       # logical Redis DB index (usually 0)

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-256-bit-minimum
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h           # 7 days

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting (Redis sliding-window)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_RPM=5             # /auth/* — 5 requests per minute per IP
RATE_LIMIT_API_RPM=100            # /api/v1/* — 100 requests per minute per IP

# ─────────────────────────────────────────────────────────────────────────────
# Kafka (optional — disabled when KAFKA_BROKERS is empty)
# ─────────────────────────────────────────────────────────────────────────────
# KAFKA_BROKERS=localhost:9092,localhost:9093
# KAFKA_CLIENT_ID=vitalcache-server

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OpenTelemetry (optional — disabled when empty)
# ─────────────────────────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318

# ─────────────────────────────────────────────────────────────────────────────
# Metrics (/metrics endpoint)
# ─────────────────────────────────────────────────────────────────────────────
# METRICS_PROTECTED=true          # set to any non-empty value to restrict
# METRICS_ALLOW_IPS=127.0.0.1,10.0.0.0/8

# ─────────────────────────────────────────────────────────────────────────────
# AWS Secrets Manager (optional — disabled when AWS_REGION or AWS_SECRET_ID is empty)
# Provides an alternative to .env for production secret delivery.
# ─────────────────────────────────────────────────────────────────────────────
# AWS_REGION=ap-south-1
# AWS_SECRET_ID=vitalcache/prod
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Auth cookies
# ─────────────────────────────────────────────────────────────────────────────
# COOKIE_DOMAIN=                  # leave empty for localhost
# DEV_INSECURE_COOKIES=true       # set to disable Secure flag in dev (HTTP)
# REFRESH_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# Legacy Supabase HTTP client (kept during transition — will be removed in Step 4)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_KEY=your-service-role-key
